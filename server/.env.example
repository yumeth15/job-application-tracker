# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB Atlas connection string
# Atlas → Database → Connect → Drivers → copy connection string
# Replace <password> with your database user password (URL-encode special chars)
# Add your IP under Atlas → Network Access before connecting locally
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/job-tracker?retryWrites=true&w=majority

# Server port (optional — defaults to 5000)
PORT=5000
